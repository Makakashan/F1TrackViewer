# Optional local env. Safe to leave empty for MVP 1.
# Used only when you wire up the database in later milestones.
DATABASE_URL="file:./dev.db"

# Admin panel (/admin) — car model inspector and start/finish calibration.
# The route renders a blank page unless BOTH are set.
#
# These are NEXT_PUBLIC_, so they are inlined into the client bundle and are
# readable by anyone who opens it. On static hosting that is unavoidable: there
# is no server to check a password against. Treat this as hiding the tool from
# casual visitors, not as access control — never reuse a real password here.
NEXT_PUBLIC_ADMIN_USERNAME=""
NEXT_PUBLIC_ADMIN_PASSWORD=""
