{
  "name": "f1-track-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "cars:generate": "bun scripts/generate-car-manifest.ts",
    "cars:lods": "bun scripts/generate-team-cars.ts cars/apx_gp.glb --ratio 0.04 --error 0.2",
    "cars:teams": "bun scripts/generate-team-cars.ts cars/apx_gp.glb",
    "circuits:generate": "bun scripts/generate-circuits.ts",
    "dev": "next dev -p 4000",
    "elevations:generate": "bun scripts/generate-elevations.ts",
    "env:audit": "bun scripts/audit-environment.ts",
    "env:audit:all": "bun scripts/audit-environment.ts --all",
    "assets:fetch": "bun scripts/fetch-assets.ts",
    "env:bake": "bun scripts/env/bake.ts",
    "env:bake:all": "bun scripts/env/bake-all.ts",
    "env:fixture": "bun scripts/env/fixture.ts",
    "env:field": "bun scripts/env/heightfield.ts",
    "env:preview": "bun scripts/env/preview.ts",
    "env:shots": "bun scripts/env/shots.ts",
    "env:raster": "bun scripts/env/raster.ts",
    "environment:generate": "bun scripts/generate-environment.ts",
    "lint": "eslint .",
    "race:audit": "bun scripts/audit-race-sim.ts",
    "race:gaps": "bun scripts/audit-gaps.ts",
    "race:kerbs": "bun scripts/audit-kerbs.ts",
    "race:laptimes": "bun scripts/audit-lap-times.ts",
    "start": "next start -p 4000",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "widths:generate": "bun scripts/generate-track-widths.ts"
