    "@tailwindcss/postcss": "^4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
