# Circuit geometry is tracked, not fetched: the viewer used to read it from
# raw.githubusercontent.com on every page load and GitHub answers 429 once an
# IP has pulled enough for the day. ~130 KB, regenerated by circuits:generate.
!public/circuits/
!public/circuits/**


.agents/
skills-lock.json

# raw car model drop folder (processed copies live in public/cars/)
# The base model is tracked: it is the one non-regenerable asset — every team
# car and LOD is derived from it in CI at deploy time.
/cars/*
!/cars/apx_gp.glb

# Playwright MCP scratch output — screenshots and console logs from browser
# automation runs, never part of the app.
.playwright-mcp/
